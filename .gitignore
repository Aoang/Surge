# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work

.idea
.vscode
node_modules
.DS_Store

# Generated coverage and TypeScript state
coverage
*.tsbuildinfo

# Local tooling and generated panel bundles
.pnpm-store
.playwright-cli
output/assets
output/playwright
output/index.html

# Rule files produced by workspace builders
output/Ruleset/Block/Base.set
output/Ruleset/Block/Bogus.list
output/Ruleset/Block/Xiaomi.set
output/Ruleset/CDN/
output/Ruleset/China/
output/Ruleset/Telegram/
output/Ruleset/Test/Download.list

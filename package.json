{
  "name": "surge-rules",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.21.0",
  "license": "MIT",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "pnpm build:rules && pnpm build:panel",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "format": "eslint . --fix",
    "lint": "eslint .",
    "test": "pnpm --recursive --if-present test",
    "typecheck": "pnpm --recursive --if-present typecheck",
    "build:rules": "pnpm --filter @surge/builder build",
    "build:panel": "pnpm --filter @surge/panel build",
    "dev": "pnpm --filter @surge/panel dev"
  },
  "devDependencies": {
    "@liwo/eslint-config": "^0.6.2",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
